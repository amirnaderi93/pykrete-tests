# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the pandera user-side ValidatedFrame shape (sibling
# annotated/canonical/user_validation.pyk). Real upstream pandera
# user code keeps the validated frame in the pandas dialect; this
# fixture declares the return as PandasFrame[ValidatedFrame] but the
# body hands off to Spark via `spark.createDataFrame(pdf, schema=...)`,
# so the v1.13 PR-D1 dialect-on-return arm in operations/driver.rs
# fires D0080 with the dialect-mismatch clause: declared PandasFrame,
# body produces SparkFrame.
#
# Failure mode exercised: column NAMES + TYPES match (ValidatedFrame
# on both sides), but the DIALECT differs — declared PandasFrame,
# actual SparkFrame via the `spark.createDataFrame` handoff gate
# (operations/driver.rs `cross_dialect_handoff_gate`). The v1.13
# PR-D1 arm closes the gap the v1.12 D0080 probes filed as a known
# limitation.
#
# Vacuity-falsifying: removing the `spark.createDataFrame(...)` wrap
# (returning `pdf` directly) clears the fire — both sides become
# PandasFrame[ValidatedFrame].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a pandas return and then
# convert to Spark inside the function. This fixture mirrors the
# shape of work pandera USERS do AROUND the validation API (annotate
# a return Schema for the validated frame, accidentally promote to
# Spark before returning). The ValidatedFrame schema IS faithful to
# the donor.

from pykrete import PandasFrame
from pyspark.sql import SparkSession


class ValidatedFrame(Schema):
    raw_amount: double
    row_count: long
    category: string


def validate_then_promote_to_spark(
    pdf: PandasFrame[ValidatedFrame],
    spark: SparkSession,
) -> PandasFrame[ValidatedFrame]:
# PROBE-EXPECTS: D0080 on "spark.createDataFrame(pdf, schema=ValidatedFrame)" id=pandera-pandas-neg-return-dialect-mismatch-createdataframe -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared PandasFrame[ValidatedFrame] but body produces SparkFrame[ValidatedFrame] via spark.createDataFrame handoff (cross_dialect_handoff_gate in operations/driver.rs flips the dialect to Spark); v1.13 dialect comparison fires D0080 on the return expression range; vacuity-falsifying because returning pdf directly clears the fire
    return spark.createDataFrame(pdf, schema=ValidatedFrame)
