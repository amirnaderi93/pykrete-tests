# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from dbt-spark's Cursor.execute QueryResult shape (sibling
# annotated/dbt/adapters/spark/session.pyk + the upstream
# dbt/adapters/spark/session.py Cursor result at dbt-labs/dbt-spark
# pinned-commit 42700b5d). Real upstream dbt-spark code holds the
# Cursor result as a Spark frame; this fixture declares the return as
# SparkFrame[QueryResult] but the body hands off to pandas via
# `.toPandas()`, so the v1.13 PR-D1 dialect-on-return arm in
# operations/driver.rs fires D0080 with the dialect-mismatch clause:
# declared SparkFrame, body produces PandasFrame.
#
# Failure mode exercised: column NAMES + TYPES match (QueryResult on
# both sides), but the DIALECT differs — declared SparkFrame, actual
# PandasFrame after `.toPandas()`. The v1.13 PR-D1 arm closes the gap
# the v1.12 D0080 probes filed as a known limitation.
#
# Vacuity-falsifying: removing the `.toPandas()` call clears the fire
# — both sides become SparkFrame[QueryResult].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a Spark return and then
# convert to pandas inside the function. This fixture mirrors the
# shape of work users do AROUND dbt-spark's Cursor wrapper (annotate
# a return Schema for the query result, then accidentally hand off to
# pandas before returning). The QueryResult schema IS faithful to the
# donor.

from pykrete import SparkFrame


class QueryResult(Schema):
    id: int
    msg: string


def cursor_forward_topandas(df: SparkFrame[QueryResult]) -> SparkFrame[QueryResult]:
# PROBE-EXPECTS: D0080 on "df.toPandas()" id=dbt-spark-spark-neg-return-dialect-mismatch-topandas -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared SparkFrame[QueryResult] but body produces PandasFrame[QueryResult] via .toPandas() handoff; the v1.13 dialect comparison in operations/driver.rs fires D0080 on the return expression range; vacuity-falsifying because removing the .toPandas() call clears the fire
    return df.toPandas()
