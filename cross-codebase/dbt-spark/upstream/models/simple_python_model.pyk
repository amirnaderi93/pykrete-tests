#
# In dbt-spark "python models", users author a top-level `model(dbt,
# spark)` function that returns a Spark DataFrame.

def model(dbt, spark):
    dbt.config(
        materialized='table',
    )
    data = [[1, 2]] * 10
    return spark.createDataFrame(data, schema=['test1', 'test3'])
