from pykrete import PandasFrame


class ScoreRowNeg(Schema):
    id: long
    relevancy_score: double


def filter_unknown_relevancy(df: PandasFrame[ScoreRowNeg]) -> None:
# PROBE-EXPECTS: D0030 on "\"relevancy_scor\"" id=iceberg-pandas-neg-bool-mask-inner-unknown -- inner Subscript in boolean-mask must fire D0030 via piece (b) descent
    _ = df[df["relevancy_scor"] >= 0.1]
