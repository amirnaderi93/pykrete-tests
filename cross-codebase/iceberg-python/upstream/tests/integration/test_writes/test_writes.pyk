from pyspark.sql import SparkSession


def write_with_writeto(spark: SparkSession, identifier: str, format_version: int) -> None:
    test_data = [
        (1, "Alice", 25, True),
        (2, "Bob", 30, False),
        (3, "Charlie", 35, True),
        (4, "David", 28, True),
        (5, "Eve", 32, False),
    ]

    spark_df = spark.createDataFrame(test_data, ["id", "name", "age", "is_active"])
    spark.sql(f"DROP TABLE IF EXISTS {identifier}")

    spark_df.writeTo(identifier).using("iceberg").tableProperty(
        "write.format.default", "orc"
    ).tableProperty("format-version", str(format_version)).createOrReplace()

    spark_df.writeTo(identifier).using("iceberg").append()

    spark_result = spark.sql(f"SELECT * FROM {identifier}").toPandas()
