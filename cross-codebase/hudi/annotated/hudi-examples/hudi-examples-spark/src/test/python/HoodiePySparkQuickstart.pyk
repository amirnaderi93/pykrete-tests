# Annotated for pykrete from
# hudi-examples/hudi-examples-spark/src/test/python/HoodiePySparkQuickstart.py
# at apache/hudi, pinned-commit fc85e3ea.
#
# Strategy: the upstream uses methods on `self` (no schema info on
# `self.spark`), so pykrete won't enter the method bodies. The
# annotated version extracts the dataframe-typed cores into
# module-level helpers with typed inputs. The Hudi-specific
# .write.format("hudi") chain is opaque; the surface that pykrete
# actually checks is .createOrReplaceTempView, spark.sql, .schema
# introspection, .withColumn / .drop in a reduce, and F.lit + .cast.
#
# Features covered:
#   - spark.read.format("hudi").load(path) opaque -> .cast
#   - df.createOrReplaceTempView("name")
#   - spark.sql(SELECT ...) opaque -> .cast or pass-through
#   - df.limit(n)
#   - df.schema.fields iteration; (field.name, field.dataType) tuple
#   - reduce(lambda df,col: df.withColumn(name, lit(None).cast(dtype)),
#     ...) — closure over a DataFrame in a reduce
#   - reduce(lambda df,col: df.drop(col[0]), ...)
#   - F.lit(None).cast(<dtype>) — null literal with a dynamic cast type
#   - df.show() pass-through

from functools import reduce

from pyspark import sql
from pyspark.sql.functions import lit


class HudiTrip(Schema):
    uuid: string
    partitionpath: string
    ts: long
    rider: string
    driver: string
    begin_lat: double
    begin_lon: double
    end_lat: double
    end_lon: double
    fare: double


def query_data_demo(spark: sql.SparkSession, base_path: str) -> None:
    """Mirrors queryData. The read.format("hudi").load is opaque;
    cast to anchor for the temp-view + sql round-trip."""
    trips_snapshot_df = spark.read.format("hudi").load(base_path).cast(
        DataFrame[HudiTrip]
    )
    trips_snapshot_df.createOrReplaceTempView("hudi_trips_snapshot")
    spark.sql(
        "SELECT fare, begin_lon, begin_lat, ts "
        "FROM hudi_trips_snapshot WHERE fare > 20.0"
    ).show()


def soft_deletes_demo(spark: sql.SparkSession, base_path: str) -> None:
    """Mirrors softDeletes — the reduce-over-DataFrame pattern is the
    real-world idiom this fixture exists to exercise."""
    soft_delete_ds = spark.sql("SELECT * FROM hudi_trips_snapshot").cast(
        DataFrame[HudiTrip]
    ).limit(2)

    meta_columns = [
        "_hoodie_commit_time", "_hoodie_commit_seqno", "_hoodie_record_key",
        "_hoodie_partition_path", "_hoodie_file_name",
    ]
    excluded_columns = meta_columns + ["ts", "uuid", "partitionpath"]

    nullify_columns = list(
        filter(
            lambda field: field[0] not in excluded_columns,
            list(map(
                lambda field: (field.name, field.dataType),
                soft_delete_ds.schema.fields,
            )),
        )
    )

    # reduce-over-DataFrame: each step adds a withColumn or drop. The
    # df returned by each reducer call carries through to the next.
    soft_delete_df = reduce(
        lambda df, col: df.withColumn(col[0], lit(None).cast(col[1])),
        nullify_columns,
        reduce(lambda df, col: df.drop(col[0]), meta_columns, soft_delete_ds),
    )

    soft_delete_df.write.format("hudi").mode("append").save(base_path)
