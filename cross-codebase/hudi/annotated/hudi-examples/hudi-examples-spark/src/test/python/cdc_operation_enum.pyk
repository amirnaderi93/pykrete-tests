#
# Annotated for pykrete from the Hudi CDC pattern at apache/hudi,
# pinned-commit fc85e3ea. The base trip surface (uuid/partitionpath/
# fare/...) is mirrored from HoodiePySparkQuickstart.py; the
# _hoodie_operation column carries the per-row CDC change-type emitted
# by Hudi's incremental CDC reader.
#
# Vocabulary per apache/hudi HoodieOperation.java:
#   "I"  = INSERT
#   "-U" = UPDATE_BEFORE (pre-image)
#   "U"  = UPDATE_AFTER  (post-image)
#   "D"  = DELETE
# (Note: the {insert, upsert, delete, bulk_insert} strings live in
# WriteOperationType.java — that is commit-time write metadata, not the
# per-row _hoodie_operation column vocabulary.)
#
# Features covered:
#   - .filter(col("_hoodie_operation") == lit("U"))
#   - .filter(col("_hoodie_operation").isin("I", "U"))
#   - groupBy("_hoodie_operation") preserves the enum-typed key
#   - F.expr("_hoodie_operation = 'D'") SQL fragment equality

from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, lit
from pyspark.sql import functions as F


class HudiCDCTrip(Schema):
    uuid: string
    partitionpath: string
    ts: long
    fare: double
    _hoodie_operation: enum["I", "-U", "U", "D"]


def read_cdc_view(spark: SparkSession, base_path: str) -> DataFrame[HudiCDCTrip]:
    return (
        spark.read.format("hudi")
        .option("hoodie.datasource.query.type", "incremental")
        .option("hoodie.datasource.query.incremental.format", "cdc")
        .load(base_path)
        .cast(DataFrame[HudiCDCTrip])
    )


def only_updates_after(cdc: DataFrame[HudiCDCTrip]) -> DataFrame[HudiCDCTrip]:
# PROBE-RESOLVES: id=hudi-cdc-enum-updates-eq -- _hoodie_operation resolves and == in-vocab lit is clean
    return cdc.filter(col("_hoodie_operation") == lit("U"))


def inserts_and_updates(cdc: DataFrame[HudiCDCTrip]) -> DataFrame[HudiCDCTrip]:
# PROBE-RESOLVES: id=hudi-cdc-enum-inserts-isin -- .isin with two in-vocab literals is clean
    return cdc.filter(
        col("_hoodie_operation").isin("I", "U")
    )


def counts_per_op(cdc: DataFrame[HudiCDCTrip]):
# PROBE-RESOLVES: id=hudi-cdc-enum-groupby-op -- groupBy preserves _hoodie_operation; broken schema tracking would drop it
    return cdc.groupBy("_hoodie_operation").agg(F.count(lit(1)).alias("n"))


def deletes_via_expr(cdc: DataFrame[HudiCDCTrip]) -> DataFrame[HudiCDCTrip]:
# PROBE-RESOLVES: id=hudi-cdc-enum-expr-delete -- F.expr equality with in-vocab literal is clean
    return cdc.filter(F.expr("_hoodie_operation = 'D'"))
