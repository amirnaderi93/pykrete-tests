#
# Annotated for pykrete from
# hudi-examples/hudi-examples-spark/src/test/python/vector_blob_demo/
# hudi_dataframe_vector_blob_demo.py at apache/hudi,
# pinned-commit fc85e3ea.
#
# Strategy: spark.createDataFrame(rows, StructType(...)) returns an
# opaque DataFrame to pykrete (the StructType isn't statically
# introspected). The caller anchors via .cast onto a Schema that
# mirrors the build_target_schema fields. Hudi's BLOB metadata isn't
# part of pykrete's surface; the closest model is `binary` for the
# inline payload.
#
# Features covered:
#   - Schema with array<float> column
#   - Schema with binary column
#   - Row(...) positional constructor in a comprehension
#   - spark.createDataFrame(rows, schema=StructType(...)).cast(DataFrame[X])
#   - df.write.format("hudi").save(path) opaque terminal

from pyspark.sql import Row, SparkSession


class ImageEmbedding(Schema):
    image_id: string
    category: string
    label: int
    description: string
    image_bytes: binary
    width: int
    height: int
    embedding: Array[float]


def write_to_hudi_demo(spark: SparkSession, data, path: str) -> None:
    """Mirrors write_to_hudi — Row-based createDataFrame anchored to
    the ImageEmbedding schema, then opaque write."""
    rows = [
        Row(
            d["image_id"],
            d["category"],
            int(d["label"]),
            d.get("description"),
            d["image_bytes_raw"],
            int(d["width"]),
            int(d["height"]),
            [float(v) for v in d["embedding"]],
        )
        for d in data
    ]
    df = spark.createDataFrame(rows, schema=None).cast(DataFrame[ImageEmbedding])
    df.write.format("hudi").save(path)
