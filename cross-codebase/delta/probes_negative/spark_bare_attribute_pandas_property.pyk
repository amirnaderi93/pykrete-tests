from pykrete import SparkFrame


class DeltaRowAttrNeg(Schema):
    id: long
    value: double


def grab_loc(df: SparkFrame[DeltaRowAttrNeg]) -> None:
# PROBE-EXPECTS: D0091 on "loc" id=delta-spark-neg-bare-attr-pandas-property -- v1.9 PR-D2 D0091 bare-attribute path: `loc` is in PANDAS_INHERITED_PROPERTIES but the receiver `df: SparkFrame[X]` is Spark; Expr::Attribute arm dispatches without call paren and fires D0091; vacuity-falsifying because swapping `loc` for a Spark-native attribute (e.g. `columns`) clears the fire
    handle = df.loc
    _ = handle
