# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the Delta quickstart pattern (sibling
# annotated/examples/python/quickstart.pyk) — `spark.read.format("delta")
# .load(...)` (and `spark.read.parquet(path)`) yields a Spark frame
# with `id: long`. Real upstream Delta examples keep the Spark
# dialect; this fixture declares the return as PandasFrame[IdRow] but
# the body loads via `spark.read.parquet(...)`, so the v1.14 PR-D1
# Arm 2 structural recognizer (operations/driver.rs:257-274) flips
# the dialect to Spark and the v1.13 PR-D1 dialect-on-return arm
# fires D0080.
#
# Failure mode exercised: column NAMES + TYPES match (IdRow on both
# sides), but the DIALECT differs — declared PandasFrame, actual
# SparkFrame via the v1.14 PR-D1 Arm 2 `spark.read.<format>(...)`
# two-level structural constructor. Closes the v1.14 PR-D1
# cross-codebase gap: the previously-shipped 17 D0080 probes
# exercise v1.13 PR-D1 handoff shapes (`.toPandas()`,
# `spark.createDataFrame(pdf, schema=...)`) but no cross-codebase
# probe exercises the v1.14 PR-D1 Arm 2 two-level recognizer.
#
# Vacuity-falsifying: replacing the `spark.read.parquet(...)` load
# with a `.toPandas()` chain (or returning a Pandas-tagged binding)
# clears the fire — both sides become PandasFrame[IdRow].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in
# real adopter code — devs don't usually annotate a pandas return
# and then load via a Spark reader inside the function. This fixture
# mirrors the shape of work users do AROUND the Delta quickstart
# (load a Spark frame via `spark.read.<format>(...)`, accidentally
# forget to convert before returning to a downstream pandas
# pipeline). The IdRow schema IS faithful to the donor.

from pykrete import PandasFrame
from pyspark.sql import SparkSession


class IdRow(Schema):
    id: long


def load_then_return_as_pandas(spark: SparkSession) -> PandasFrame[IdRow]:
# PROBE-EXPECTS: D0080 on "spark.read.parquet(\"/tmp/delta-table\")" id=delta-pandas-neg-return-dialect-mismatch-spark-read-parquet -- v1.14 PR-D1 Arm 2 two-level structural recognizer spark.read.<format>(...) flips dialect to Spark (operations/driver.rs:257-274); declared PandasFrame[IdRow] but body produces SparkFrame[IdRow] via spark.read.parquet constructor; v1.13 PR-D1 dialect comparison fires D0080 on the return expression range; vacuity-falsifying because returning via a .toPandas() chain (or a Pandas-tagged binding) clears the fire
    return spark.read.parquet("/tmp/delta-table")
