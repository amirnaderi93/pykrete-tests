#
# Annotated for pykrete from examples/python/streaming.py at
# delta-io/delta, pinned-commit 3f10aaec.
#
# Strategy: as with the spark structured-streaming fixture, pykrete
# leaves readStream/writeStream opaque. The annotated companion lifts
# the pieces of the chain that are pure DataFrame operations
# (.selectExpr, .withColumn arithmetic, .drop) into typed helpers.
#
# Features covered:
#   - df.withColumn with an arithmetic Column expression
#   - df.withColumn with F.col(...) % scalar
#   - df.drop("timestamp") bare-string
#   - df.selectExpr("value as id") rename via SQL string
#   - long/double arithmetic on Column

from pyspark.sql import SparkSession
from pyspark.sql.functions import col


class IdValue(Schema):
    id: long
    value: long


class RateRow(Schema):
    timestamp: timestamp
    value: long


def with_value_demo(spark: SparkSession) -> None:
    """Mirrors `data.withColumn("value", data.id + random.randint(...))`.
    The scalar gets lifted into a literal during binding; pykrete
    accepts the long + int arithmetic on Column."""
    data = spark.range(8).cast(DataFrame[IdValue])
# PROBE-RESOLVES: id=delta-streaming-withColumn-data-id -- data.id resolves under IdValue
    data.withColumn("value", data.id + 3000)


def select_expr_rename_demo(df: DataFrame[RateRow]) -> None:
    """Mirrors `streamingDf.selectExpr("value as id")` — selectExpr
    accepts SQL-string projections including AS-renames."""
# PROBE-RESOLVES: id=delta-streaming-selectexpr-value -- value resolves inside selectExpr SQL fragment
    df.selectExpr("value as id")


def modulo_and_drop_demo(df: DataFrame[RateRow]) -> None:
    """Mirrors the streamingAggregatesDF.withColumn(...).drop(...)
    chain. F.col("value") % 10 is a Column-arithmetic expression."""
# PROBE-RESOLVES: id=delta-streaming-withColumn-modulo -- value resolves through col() inside withColumn arithmetic
    df.withColumn("id", col("value") % 10).drop("timestamp")
