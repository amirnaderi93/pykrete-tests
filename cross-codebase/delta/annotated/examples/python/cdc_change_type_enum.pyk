# Annotated for pykrete from the Delta CDC pattern in
# examples/python/change_data_feed.py at delta-io/delta, pinned-commit
# 3f10aaec, plus the documented CDC schema columns _change_type /
# _commit_version / _commit_timestamp from Delta Lake's Change Data
# Feed reference (docs.delta.io/.../delta-change-data-feed). The CDC
# read returns a DataFrame whose _change_type column is a string drawn
# from the documented vocabulary {insert, update_preimage,
# update_postimage, delete}; the v1.1 enum surface is what makes that
# vocabulary checkable at edit time.
#
# Features covered:
#   - spark.read.format("delta").option("readChangeFeed", "true") chain
#     re-anchored to DataFrame[StudentCDC] via .cast
#   - col("_change_type") == lit("insert") filter on enum column
#   - col("_change_type").isin("update_preimage", "update_postimage")
#   - withColumn("_change_type", lit("delete")) write-side assignment
#   - F.expr("_change_type = 'insert'") SQL-fragment equality
#   - groupBy on enum column preserves the enum-typed key

from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, lit
from pyspark.sql import functions as F


class StudentCDC(Schema):
    id: int
    name: string
    age: int
    _change_type: enum["insert", "update_preimage", "update_postimage", "delete"]
    _commit_version: long
    _commit_timestamp: timestamp


def read_cdc(spark: SparkSession, starting_version: int) -> DataFrame[StudentCDC]:
    return (
        spark.read.format("delta")
        .option("readChangeFeed", "true")
        .option("startingVersion", str(starting_version))
        .table("student")
        .cast(DataFrame[StudentCDC])
    )


def only_inserts(cdc: DataFrame[StudentCDC]) -> DataFrame[StudentCDC]:
# PROBE-RESOLVES: id=delta-cdc-enum-inserts-filter -- _change_type resolves and equality with in-vocab literal does not fire D0084
    return cdc.filter(col("_change_type") == lit("insert"))


def updates_only(cdc: DataFrame[StudentCDC]) -> DataFrame[StudentCDC]:
# PROBE-RESOLVES: id=delta-cdc-enum-updates-isin -- _change_type resolves and .isin with in-vocab literals does not fire D0084
    return cdc.filter(
        col("_change_type").isin("update_preimage", "update_postimage")
    )


def rewrite_as_deletes(cdc: DataFrame[StudentCDC]) -> DataFrame:
# PROBE-RESOLVES: id=delta-cdc-enum-withcolumn-delete -- in-vocab lit on enum sink does not fire D0084
    return cdc.withColumn("_change_type", lit("delete"))


def via_expr(cdc: DataFrame[StudentCDC]) -> DataFrame[StudentCDC]:
# PROBE-RESOLVES: id=delta-cdc-enum-expr-insert -- F.expr equality with in-vocab literal is clean
    return cdc.filter(F.expr("_change_type = 'insert'"))


def counts_by_change(cdc: DataFrame[StudentCDC]):
# PROBE-RESOLVES: id=delta-cdc-enum-groupby-change-type -- groupBy on enum key carries; broken schema tracking would drop _change_type before .agg
    return cdc.groupBy("_change_type").agg(F.count(lit(1)).alias("n"))
