# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from tests/test_checks.py's VerificationSuite(spark).onData(
# df).addCheck(check).run() → VerificationResult.checkResultsAsDataFrame
# pattern at awslabs/python-deequ pinned-commit 20693b81. The result
# DataFrame's known schema (per test_initializer) is: check,
# check_level, check_status, constraint, constraint_status,
# constraint_message. Real upstream test code calls
# df.select(*columns).collect() with `columns` defaulting to
# "constraint_status". This fixture narrows to constraint_status only
# and then references constraint_message, which the narrow dropped.
#
# Failure mode exercised: column reference not in narrowed schema
# (D0030) on the deequ VerificationResult DataFrame.

from pyspark.sql import DataFrame
from pyspark.sql.functions import col


class CheckResultNeg(Schema):
    check: string
    check_level: string
    check_status: string
    constraint: string
    constraint_status: string
    constraint_message: string


def narrow_then_drop(df: DataFrame[CheckResultNeg]) -> DataFrame:
    statuses = df.select("constraint_status")
# PROBE-EXPECTS: D0030 on "\"constraint_message\"" id=deequ-neg-verification-narrow-drop -- constraint_message was dropped by .select("constraint_status")
    return statuses.select(col("constraint_message"))
