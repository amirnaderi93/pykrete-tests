from pyspark.sql import DataFrame


class CustomerRowHandoffNeg(Schema):
    customer_id: long
    name: string
    is_active: bool


def to_pandas_then_unknown(df: DataFrame[CustomerRowHandoffNeg]):
    pdf = df.toPandas()
# PROBE-EXPECTS: D0030 on "\"email\"" id=deequ-neg-to-pandas-unknown -- email is not in CustomerRowHandoffNeg; checked on the pandas side after .toPandas()
    return pdf[["email"]]
