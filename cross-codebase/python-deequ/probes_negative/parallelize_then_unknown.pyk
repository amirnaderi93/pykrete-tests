# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from tests/test_analyzers.py's setUpClass shape at
# awslabs/python-deequ pinned-commit 20693b81 — sc.parallelize([
# Row(a=..., b=..., c=..., d=...)]).toDF(). The annotated/ companion
# .casts onto InputRow; this fixture mirrors the same re-anchor then
# references a column the schema doesn't declare. Exercises deequ's
# schema-introspection-style fixture-build pattern, which feeds every
# downstream AnalysisRunner / VerificationSuite call.
#
# Failure mode exercised: column not in schema (D0030) after the
# sc.parallelize(...).toDF().cast(DataFrame[X]) re-anchor that deequ
# tests use for input-data setup.

from pyspark.sql import DataFrame, Row, SparkSession
from pyspark.sql.functions import col


class InputRowNeg(Schema):
    a: string
    b: int
    c: int
    d: int


def build_then_unknown(spark: SparkSession) -> DataFrame:
    sc = spark.sparkContext
    df = sc.parallelize([
        Row(a="foo", b=1, c=5, d=1),
        Row(a="bar", b=2, c=6, d=3),
    ]).toDF().cast(DataFrame[InputRowNeg])
# PROBE-EXPECTS: D0030 on "\"e\"" id=deequ-neg-parallelize-unknown -- e is not in InputRowNeg (real Row had a, b, c, d only)
    return df.select(col("e"))
