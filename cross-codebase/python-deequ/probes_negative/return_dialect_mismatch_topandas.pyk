# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the python-deequ test_analyzers InputRow shape (sibling
# annotated/tests/test_analyzers.pyk). Real upstream python-deequ
# code keeps the analyzed frame in the Spark dialect (deequ runs
# against Spark DataFrames); this fixture declares the return as
# SparkFrame[InputRow] but the body hands off to pandas via
# `.toPandas()`, so the v1.13 PR-D1 dialect-on-return arm in
# operations/driver.rs fires D0080 with the dialect-mismatch clause:
# declared SparkFrame, body produces PandasFrame.
#
# Failure mode exercised: column NAMES + TYPES match (InputRow on
# both sides), but the DIALECT differs — declared SparkFrame, actual
# PandasFrame after `.toPandas()`. Direct .toPandas() shape — widens
# Spark-only donor coverage to python-deequ.
#
# Vacuity-falsifying: removing the `.toPandas()` call (returning `df`
# directly) clears the fire — both sides become SparkFrame[InputRow].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a Spark return and then
# convert to pandas inside the function. This fixture mirrors the
# shape of work users do AROUND python-deequ analyzers (build a
# Spark input frame, accidentally hand off to pandas before
# returning). The InputRow schema IS faithful to the donor.

from pykrete import SparkFrame


class InputRow(Schema):
    a: string
    b: int
    c: int
    d: int


def analyze_then_topandas(df: SparkFrame[InputRow]) -> SparkFrame[InputRow]:
# PROBE-EXPECTS: D0080 on "df.toPandas()" id=python-deequ-spark-neg-return-dialect-mismatch-topandas -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared SparkFrame[InputRow] but body produces PandasFrame[InputRow] via .toPandas() handoff; the v1.13 dialect comparison in operations/driver.rs fires D0080 on the return expression range; vacuity-falsifying because removing the .toPandas() call clears the fire
    return df.toPandas()
