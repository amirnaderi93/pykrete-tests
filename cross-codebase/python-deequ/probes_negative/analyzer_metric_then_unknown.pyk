# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from tests/test_analyzers.py's AnalysisRunner.onData(...)
# .addAnalyzer(...).run() → AnalyzerContext.successMetricsAsDataFrame
# pattern at awslabs/python-deequ pinned-commit 20693b81. Real
# upstream code calls `result_df.select("value").collect()` against
# the MetricRow shape. This fixture mirrors that flow but references
# a column not in MetricRowNeg.
#
# Failure mode exercised: column not in schema (D0030) on the deequ
# metric-result DataFrame — exercises the most-frequent deequ pattern
# (AnalysisRunner → AnalyzerContext) at the static boundary.

from pyspark.sql import DataFrame
from pyspark.sql.functions import col


class MetricRowNeg(Schema):
    entity: string
    instance: string
    name: string
    value: double


def metric_select_unknown(metric_df: DataFrame[MetricRowNeg]) -> DataFrame:
# PROBE-EXPECTS: D0030 on "\"variance\"" id=deequ-neg-metric-unknown -- variance is not in MetricRowNeg
    return metric_df.select(col("variance"))
