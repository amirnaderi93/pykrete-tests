from typing import Union

from pyspark.sql import DataFrame, SparkSession


class CustomerRow(Schema):
    customer_id: long
    name: string
    is_active: bool


def pandas_to_pyspark_demo(spark: SparkSession, pandas_df) -> DataFrame[CustomerRow]:
    """Mirrors PandasConverter.pandasDF_to_pysparkDF. The StructType
    arg is opaque; cast onto a known shape."""
    columns = list(pandas_df.columns)
    types = list(pandas_df.dtypes)
    _ = (columns, types)
    # In real code, build_struct_type(columns, types) constructs a
    # StructType; we treat the resulting createDataFrame as opaque.
    return spark.createDataFrame(pandas_df, schema=None).cast(DataFrame[CustomerRow])


def pyspark_to_pandas_demo(df: DataFrame[CustomerRow]):
    """Mirrors PandasConverter.pysparkDF_to_pandasDF."""
    return df.toPandas()


def select_customer_demo(df: DataFrame[CustomerRow]) -> None:
    """pykrete-typed helper: customer_id and name resolve under
    CustomerRow; narrowed filter on customer_id proves chain."""
# PROBE-RESOLVES: id=deequ-pandas-utils-select-customer -- customer_id and name resolve under CustomerRow
    df.select("customer_id", "name").collect()
    narrowed = df.select("customer_id", "name")
# PROBE-RESOLVES: id=deequ-pandas-utils-narrowed-filter-customer -- customer_id resolves on narrowed result; broken .select() would lose customer_id
    narrowed.filter(narrowed.customer_id > 0).collect()
