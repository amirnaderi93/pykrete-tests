# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the quinn dataframe_helpers PersonRow shape (sibling
# annotated/quinn/dataframe_helpers.pyk). Real upstream quinn code
# keeps the helper frame in the Spark dialect (quinn is a Spark-only
# helper library); this fixture declares the return as
# SparkFrame[PersonRow] but the body hands off to pandas via
# `.toPandas()`, so the v1.13 PR-D1 dialect-on-return arm in
# operations/driver.rs fires D0080 with the dialect-mismatch clause:
# declared SparkFrame, body produces PandasFrame.
#
# Failure mode exercised: column NAMES + TYPES match (PersonRow on
# both sides), but the DIALECT differs — declared SparkFrame, actual
# PandasFrame after `.toPandas()`. Direct .toPandas() shape — widens
# Spark-only donor coverage to quinn.
#
# Vacuity-falsifying: removing the `.toPandas()` call (returning `df`
# directly) clears the fire — both sides become SparkFrame[PersonRow].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a Spark return and then
# convert to pandas inside the function. This fixture mirrors the
# shape of work users do AROUND quinn helpers (run a transformation
# on a PersonRow frame, accidentally hand off to pandas before
# returning). The PersonRow schema IS faithful to the donor.

from pykrete import SparkFrame


class PersonRow(Schema):
    name: string
    age: int


def transform_persons_then_topandas(df: SparkFrame[PersonRow]) -> SparkFrame[PersonRow]:
# PROBE-EXPECTS: D0080 on "df.toPandas()" id=quinn-spark-neg-return-dialect-mismatch-topandas -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared SparkFrame[PersonRow] but body produces PandasFrame[PersonRow] via .toPandas() handoff; the v1.13 dialect comparison in operations/driver.rs fires D0080 on the return expression range; vacuity-falsifying because removing the .toPandas() call clears the fire
    return df.toPandas()
