#
# Annotated for pykrete from quinn/transformations.py at MrPowers/quinn,
# pinned-commit 20156582.
#
# Strategy: upstream helpers take a plain `DataFrame` (no schema), so
# pykrete doesn't enter their bodies. We add typed callers that drive
# the same operations through DataFrame[X] inputs, exercising the
# bare-string column refs, F.col(...) variants, .select, .drop, .alias,
# F.explode_outer + F.map_keys, .getItem, and the collect-then-iterate
# pattern that flatten_map uses.
#
# Features covered:
#   - df.select with mixed bare-string + F.col + .alias
#   - df.drop with a column-object argument
#   - df.columns introspection
#   - F.col("name").alias("other") rename pattern
#   - F.explode_outer over F.map_keys
#   - Column.getItem(key) on a map<string,V>
#   - .distinct + .collect pipeline
#   - StructType-style "nested.field" path-form column refs (.field1.sub)

from __future__ import annotations

from pyspark.sql import DataFrame
from pyspark.sql import functions as F


# ----------------------------------------------------------------------
# pykrete schemas — typed-DataFrame inputs for the demo helpers.
# ----------------------------------------------------------------------


class FlatRow(Schema):
    first_name: string
    last_name: string
    age: int


class WithStruct(Schema):
    id: int
    info: Struct  # opaque struct — flatten_struct uses bare strings only


class WithMap(Schema):
    id: int
    tags: Map[string, int]


# ----------------------------------------------------------------------
# pykrete-typed demo helpers.
# ----------------------------------------------------------------------


def rename_all_demo(df: DataFrame[FlatRow]) -> None:
    """Mirrors with_columns_renamed/snake_case_col_names application.
    Real quinn callers feed the curried renamer a DataFrame, which
    re-emits df.select with each col aliased."""
    cols = [F.col(f"`{c}`").alias(c.lower().replace(" ", "_")) for c in df.columns]
    df.select(*cols)


def rename_some_demo(df: DataFrame[FlatRow]) -> None:
    """Mirrors with_some_columns_renamed. The bare-or-aliased
    F.col(...) inside a comprehension is a real quinn idiom that
    pykrete must accept."""
    cols = [
        F.col(f"`{c}`").alias("renamed_" + c) if c.startswith("first") else F.col(f"`{c}`")
        for c in df.columns
    ]
    df.select(*cols)


def flatten_struct_demo(df: DataFrame[WithStruct]) -> None:
    """Mirrors flatten_struct — uses dotted backtick refs to project
    sub-fields then drops the original struct column."""
    expanded = [
        F.col("`info`.`name`").alias("info:name"),
        F.col("`info`.`age`").alias("info:age"),
    ]
    df.select("*", *expanded).drop(F.col("`info`"))


def flatten_map_demo(df: DataFrame[WithMap]) -> None:
    """Mirrors flatten_map — collects the key set, then projects each
    key as its own column via Column.getItem."""
    keys_df = df.select(F.explode_outer(F.map_keys(F.col("`tags`")))).distinct()
    keys = [row[0] for row in keys_df.collect()]
    key_cols = [
        F.col("`tags`").getItem(k).alias("tags:" + k) for k in keys
    ]
    df.select(
        [F.col(f"`{c}`") for c in df.columns if c != "tags"] + key_cols,
    )


def select_flat_demo(df: DataFrame[FlatRow]) -> None:
    """pykrete-typed helper: bare-string col refs against FlatRow."""
# PROBE-RESOLVES: id=quinn-transformations-select-flat -- first_name and age resolve under FlatRow
    df.select("first_name", "age").collect()


# ----------------------------------------------------------------------
# Original upstream helpers (unchanged from MrPowers/quinn@20156582).
# ----------------------------------------------------------------------


def to_snake_case(s: str) -> str:
    return s.lower().replace(" ", "_")
