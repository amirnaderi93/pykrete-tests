# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from mlflow's pandas_dataset TrainRow shape (sibling
# annotated/mlflow/data/pandas_dataset.pyk). Real upstream mlflow
# code keeps the training frame in the dialect the dataset was built
# with; this fixture declares the return as SparkFrame[TrainRow] but
# forwards a PandasFrame-typed parameter directly, so the v1.13
# PR-D1 dialect-on-return arm in operations/driver.rs fires D0080
# with the dialect-mismatch clause: declared SparkFrame, body
# produces PandasFrame.
#
# Failure mode exercised: column NAMES + TYPES match (TrainRow on
# both sides), but the DIALECT differs — declared SparkFrame, actual
# PandasFrame from the parameter binding. No chained handoff: the
# direct-name return is the simplest shape the v1.13 arm catches,
# distinct from the .toPandas() handoff shapes.
#
# Vacuity-falsifying: flipping the parameter annotation to
# SparkFrame[TrainRow] clears the fire — both sides become
# SparkFrame.
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually pair a SparkFrame return with a
# PandasFrame parameter and forward the parameter directly. This
# fixture mirrors the shape of work users do AROUND mlflow's
# pandas_dataset (annotate the training frame on a Spark code path,
# accidentally take a pandas-typed input). The TrainRow schema IS
# faithful to the donor.

from pykrete import SparkFrame, PandasFrame


class TrainRow(Schema):
    feature_a: double
    feature_b: double
    target: long


def forward_pandas_as_spark(pdf: PandasFrame[TrainRow]) -> SparkFrame[TrainRow]:
# PROBE-EXPECTS: D0080 on "pdf" id=mlflow-spark-neg-return-dialect-mismatch-pandas-name -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared SparkFrame[TrainRow] but body produces PandasFrame[TrainRow] via direct return of a PandasFrame-typed name; the v1.13 dialect comparison in operations/driver.rs fires D0080 on the return expression range; vacuity-falsifying because flipping the parameter annotation to SparkFrame[TrainRow] clears the fire
    return pdf
