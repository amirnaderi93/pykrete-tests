# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the same TrainRow shape as the sibling
# annotated/mlflow/data/pandas_dataset.pyk. Exercises the §5
# "Column add / replace" dispatch row, pandas form
# `df["new"] = expr` (per docs/design/pandas-support.md §5).
# The RHS column reference is a typo of `target`; piece (b)'s
# col-ref check must fire D0030 on the RHS Subscript.
#
# Failure mode exercised: pandas assignment-Subscript dispatch row;
# typo on RHS column lookup fires D0030 (unknownColumn).

from pykrete import PandasFrame


class TrainRowAssignNeg(Schema):
    feature_a: double
    feature_b: double
    target: long


def assign_unknown_source(df: PandasFrame[TrainRowAssignNeg]) -> None:
# PROBE-EXPECTS: D0030 on "\"targt\"" id=mlflow-pandas-neg-assign-subscript-unknown -- pandas assign-Subscript dispatch row from §5; the RHS df["typo"] is checked by piece (b)'s shared col-ref machinery (the same machinery a Spark receiver would route through), so this probe verifies col-ref reaches the RHS — it does not by itself prove the dispatch is pandas-specific. Pandas-routed assign coverage at the dispatch layer is gapped on the positive side (PROBE-TYPE-IS recognizer for PandasFrame[X] deferred to v1.4 — see follow-up).
    df["new"] = df["targt"]
