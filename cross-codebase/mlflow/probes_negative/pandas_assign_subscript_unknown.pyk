# typo on RHS column lookup fires D0030 (unknownColumn).

from pykrete import PandasFrame


class TrainRowAssignNeg(Schema):
    feature_a: double
    feature_b: double
    target: long


def assign_unknown_source(df: PandasFrame[TrainRowAssignNeg]) -> None:
# PROBE-EXPECTS: D0030 on "\"targt\"" id=mlflow-pandas-neg-assign-subscript-unknown -- df["new"] = df["typo"] must fire D0030 on the RHS Subscript via piece (b)
    df["new"] = df["targt"]
