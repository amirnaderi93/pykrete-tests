# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from apache/spark's test_dataframe.py NameAgeActive pattern
# (sibling annotated/python/pyspark/sql/tests/test_dataframe.pyk at
# pinned-commit d004e0d8). Real upstream Spark test code keeps the
# frame as a Spark DataFrame; this fixture declares the return as
# SparkFrame[NameAgeActive] but the body hands off to pandas via
# `.toPandas()`, so the v1.13 PR-D1 dialect-on-return arm in
# operations/driver.rs fires D0080 with the dialect-mismatch clause:
# declared SparkFrame, body produces PandasFrame.
#
# Failure mode exercised: column NAMES + TYPES match (NameAgeActive
# on both sides), but the DIALECT differs — declared SparkFrame,
# actual PandasFrame after `.toPandas()`. The v1.13 PR-D1 arm closes
# the gap the v1.12 D0080 probes filed as a known limitation.
#
# Vacuity-falsifying: removing the `.toPandas()` call (returning `df`
# directly) clears the fire — both sides become SparkFrame[NameAgeActive].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a Spark return and then
# convert to pandas inside the function. This fixture mirrors the
# shape of work users do AROUND apache/spark's pandas-conversion test
# helpers (forward a typed Spark frame, accidentally chain `.toPandas()`
# before returning). The NameAgeActive schema IS faithful to the donor.

from pykrete import SparkFrame


class NameAgeActive(Schema):
    name: string
    age: int
    active: string


def name_age_active_forward_topandas(df: SparkFrame[NameAgeActive]) -> SparkFrame[NameAgeActive]:
# PROBE-EXPECTS: D0080 on "df.toPandas()" id=spark-spark-neg-return-dialect-mismatch-topandas -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared SparkFrame[NameAgeActive] but body produces PandasFrame[NameAgeActive] via .toPandas() handoff; the v1.13 dialect comparison in operations/driver.rs fires D0080 on the return expression range; vacuity-falsifying because removing the .toPandas() call clears the fire
    return df.toPandas()
