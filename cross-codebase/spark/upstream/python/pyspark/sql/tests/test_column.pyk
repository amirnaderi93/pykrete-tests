# Excerpt from python/pyspark/sql/tests/test_column.py at apache/spark,
# pinned-commit d004e0d8.

from pyspark.sql import Column
from pyspark.sql import functions as sf
from pyspark.sql.types import LongType


class ColumnTestsMixin:
    def test_and_in_expression(self):
        self.df.filter((self.df.key <= 10) & (self.df.value <= "2")).count()
        self.df.filter((self.df.key <= 3) | (self.df.value < "2")).count()
        self.df.filter(~(self.df.key == 1)).count()

    def test_column_operators(self):
        ci = self.df.key
        cs = self.df.value
        ci == cs
        (-ci - 1 - 2) % 3 * 2.5 / 3.5
        (1 + ci), (1 - ci), (1 * ci), (1 / ci), (1 % ci), (1 ** ci), (ci ** 1)
        ci == 5, ci != 0, ci > 3, ci < 4, ci >= 0, ci <= 7
        (ci & ci), (ci | ci), (~ci)
        cs.contains("a")
        cs.like("a")
        cs.rlike("a")
        cs.ilike("A")
        cs.asc()
        cs.desc()
        cs.startswith("a")
        cs.endswith("a")
        ci.eqNullSafe(cs)
        sf.col("b") & sf.lit(True)
        sf.col("b") & True
        sf.lit(True) & sf.col("b")
        ci.cast(LongType())
