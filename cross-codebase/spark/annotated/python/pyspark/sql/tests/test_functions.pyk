# Annotated for pykrete from
# python/pyspark/sql/tests/test_functions.py at apache/spark,
# pinned-commit d004e0d8.
#
# Strategy: pull a substantial cross-section of the F.* surface into
# helpers, each typed against a Schema whose shape matches the data
# rows the test constructs. Original test methods kept verbatim below.
#
# Features covered:
#   - F.explode / F.explode_outer / F.posexplode_outer
#   - Array<int> + Map<string,string> shapes
#   - F.cos / F.sin / F.pow / F.hypot (math; mixed col and literal args)
#   - F.rand / F.randn (no-arg + seeded forms)
#   - F.lit (literal column construction)

import math

from pyspark.sql import Row, types
from pyspark.sql import functions as F


# ----------------------------------------------------------------------
# pykrete schemas — matched to the Row shapes the upstream tests build.
# ----------------------------------------------------------------------


class CollectionRow(Schema):
    a: int
    intlist: Array[int]
    mapfield: Map[string, string]


class AB(Schema):
    a: int
    b: int


class KV(Schema):
    key: int
    value: string


# ----------------------------------------------------------------------
# pykrete-typed helpers
# ----------------------------------------------------------------------


def explode_demo(data: DataFrame[CollectionRow]) -> None:
    """Mirrors test_explode."""
    # array<int> → int (single column)
    data.select(F.explode(data.intlist).alias("a")).select("a").collect()
    # map<string,string> → key + value columns (multi-alias)
    data.select(F.explode(data.mapfield).alias("a", "b")).select("a", "b").collect()
    # posexplode_outer on a bare-string column ref
    data.select(F.posexplode_outer("intlist")).collect()
    data.select(F.posexplode_outer("mapfield")).collect()
    # explode_outer
    data.select(F.explode_outer("intlist")).collect()
    data.select(F.explode_outer("mapfield")).collect()


def math_functions_demo(df: DataFrame[AB]) -> None:
    """Mirrors test_math_functions. Each F.* below is recognised in
    the COLUMN_REF list or has its first arg checked; mixed col+lit
    args are common in real code."""
    df.select(F.cos(df.a)).collect()
    df.select(F.cos("a")).collect()
    df.select(F.sin(df.a)).collect()
    df.select(F.sin(df["a"])).collect()
    df.select(F.pow(df.a, df.b)).collect()
    df.select(F.pow(df.a, 2)).collect()
    df.select(F.pow(df.a, 2.0)).collect()
    df.select(F.hypot(df.a, df.b)).collect()
    df.select(F.hypot("a", "b")).collect()
    df.select(F.hypot("a", 2)).collect()
    df.select(F.hypot(df.a, 2)).collect()


def rand_functions_demo(df: DataFrame[KV]) -> None:
    """Mirrors test_rand_functions. F.rand / F.randn are no-arg or
    take a seed; both forms exercised here."""
    df.select("key", F.rand()).collect()
    df.select("key", F.randn(5)).collect()
    df.select("key", F.rand(0)).collect()
    df.select("key", F.randn(0)).collect()


# ----------------------------------------------------------------------
# Original upstream test class (unchanged from apache/spark@d004e0d8).
# Subset only.
# ----------------------------------------------------------------------


class FunctionsTestsMixin:
    def test_explode(self):
        d = [
            Row(a=1, intlist=[1, 2, 3], mapfield={"a": "b"}),
            Row(a=1, intlist=[], mapfield={}),
            Row(a=1, intlist=None, mapfield=None),
        ]
        data = self.spark.createDataFrame(d)

        data.select(F.explode(data.intlist).alias("a")).select("a").collect()
        data.select(F.explode(data.mapfield).alias("a", "b")).select("a", "b").collect()
        data.select(F.posexplode_outer("intlist")).collect()
        data.select(F.posexplode_outer("mapfield")).collect()
        data.select(F.explode_outer("intlist")).collect()
        data.select(F.explode_outer("mapfield")).collect()

    def test_math_functions(self):
        df = self.spark.createDataFrame([Row(a=i, b=2 * i) for i in range(10)])

        df.select(F.cos(df.a)).collect()
        df.select(F.cos("a")).collect()
        df.select(F.sin(df.a)).collect()
        df.select(F.sin(df["a"])).collect()
        df.select(F.pow(df.a, df.b)).collect()
        df.select(F.pow(df.a, 2)).collect()
        df.select(F.hypot(df.a, df.b)).collect()
        df.select(F.hypot("a", "b")).collect()

    def test_rand_functions(self):
        df = self.spark.createDataFrame([Row(key=i, value=str(i)) for i in range(100)])

        df.select("key", F.rand()).collect()
        df.select("key", F.randn(5)).collect()
        df.select("key", F.rand(0)).collect()
        df.select("key", F.randn(0)).collect()
