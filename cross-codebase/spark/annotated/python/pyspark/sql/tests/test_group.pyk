# Annotated for pykrete from python/pyspark/sql/tests/test_group.py
# at apache/spark, pinned-commit d004e0d8.
#
# Strategy: per the apache/spark fixture convention, lift the typed
# cores into helpers, keep the upstream class verbatim. The agg /
# pivot surface this exercises is broad — F.first, F.last,
# F.approx_count_distinct, F.countDistinct, dict-form agg, pivot
# with and without values list, GroupedData.{max/min/sum/count/mean}.
#
# Features covered:
#   - df.groupBy("key").max("value") / .min / .sum / .count / .mean
#   - df.groupBy() (no key) -> agg dict {"key": "max", "value": "count"}
#   - GroupedData.agg(functions.first(col), functions.last(col)).first()
#   - F.approx_count_distinct, F.countDistinct
#   - df.groupBy("year").pivot("electronic", ["a", "b"]).sum("sales")
#   - df.groupBy("year").pivot("electronic").sum("sales") (no values)

from pyspark.sql import Row
from pyspark.sql import functions as sf


class KV(Schema):
    key: int
    value: int


class Sales(Schema):
    electronic: string
    year: int
    sales: long


def agg_func_demo(df: DataFrame[KV], df_pivot: DataFrame[Sales]) -> None:
    """Mirrors test_agg_func."""
# PROBE-RESOLVES: id=spark-test-group-key-as-groupBy -- key resolves as groupBy arg under KV
    g = df.groupBy("key")
# PROBE-RESOLVES: id=spark-test-group-max-value -- value resolves as agg target on GroupedData
    g.max("value")
    g.min("value")
    g.sum("value")
    g.count()
    g.mean("value")

# PROBE-RESOLVES: id=spark-test-group-pivot-electronic -- year, electronic, sales all resolve under Sales
    df_pivot.groupBy("year").pivot("electronic", ["Smartphone", "Tablet"]).sum("sales")
    df_pivot.groupBy("year").pivot("electronic").sum("sales")


def aggregator_demo(df: DataFrame[KV]) -> None:
    """Mirrors test_aggregator. .groupBy() with no key returns a
    GroupedData that aggregates across all rows."""
    g = df.groupBy()
    from pyspark.sql import functions
# PROBE-RESOLVES: id=spark-test-group-agg-dict -- key and value resolve as agg dict keys
    g.agg({"key": "max", "value": "count"}).collect()
    g.mean().collect()
# PROBE-RESOLVES: id=spark-test-group-first-last -- key and value resolve as first/last column refs
    g.agg(functions.first(df.key), functions.last(df.value)).first()
    g.agg(functions.approx_count_distinct(df.key)).first()
    g.agg(functions.countDistinct(df.value)).first()


# Original upstream class preserved for traceability (see test_group.py
# in upstream/ for the verbatim version).
class GroupTestsMixin:
    pass
