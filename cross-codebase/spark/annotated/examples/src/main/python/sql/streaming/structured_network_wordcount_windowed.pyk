# Annotated for pykrete from
# examples/src/main/python/sql/streaming/structured_network_wordcount_windowed.py
# at apache/spark, pinned-commit d004e0d8.
#
# Strategy: pykrete intentionally does not model readStream / writeStream
# (the API is opaque by design — schemas come from runtime sources). The
# extracted helpers focus on the downstream operations applied to the
# already-shaped DataFrame: split + explode + alias, then a groupBy
# over a window function. The user re-anchors the streaming chain with
# .cast(DataFrame[LinesWithTimestamp]) once at the top.
#
# Features covered:
#   - F.split (mixed-arg helper, → array<string>)
#   - F.explode (array<T> → T)
#   - F.window (windowing function on a timestamp column)
#   - .groupBy + .count + .orderBy on a window-grouped DataFrame
#   - lines.value / lines.timestamp attribute-form column refs
#   - .alias on an exploded column

import sys

from pyspark.sql import SparkSession
from pyspark.sql.functions import explode
from pyspark.sql.functions import split
from pyspark.sql.functions import window


# ----------------------------------------------------------------------
# pykrete schemas — socket source emits a single string column `value`
# plus a `timestamp` column when `includeTimestamp` is set true.
# ----------------------------------------------------------------------


class LinesWithTimestamp(Schema):
    value: string
    timestamp: timestamp


# ----------------------------------------------------------------------
# pykrete-typed helpers — extracted from the streaming pipeline above.
# ----------------------------------------------------------------------


def split_and_explode(lines: DataFrame[LinesWithTimestamp]) -> None:
    """Mirrors the lines.select(...) step. `split(value, ' ')` produces
    an array<string>; explode then flattens it; the alias names the
    result `word`. `lines.timestamp` carries through as-is."""
# PROBE-RESOLVES: id=spark-streaming-split-value-timestamp -- value and timestamp resolve via attribute access
    lines.select(
        explode(split(lines.value, ' ')).alias('word'),
        lines.timestamp,
    )


def windowed_count_demo(lines: DataFrame[LinesWithTimestamp]) -> None:
    """Mirrors the whole windowed-counts pipeline, end-to-end with the
    same column refs as the upstream script."""
# PROBE-RESOLVES: id=spark-streaming-words-select -- value+timestamp resolve in select that builds words
    words = lines.select(
        explode(split(lines.value, ' ')).alias('word'),
        lines.timestamp,
    )
    # window() on a timestamp column is recognised as a column ref;
    # downstream groupBy + count + orderBy are pass-throughs in pykrete.
# PROBE-RESOLVES: id=spark-streaming-windowed-groupby -- timestamp resolves inside window(...) groupby key
    words.groupBy(
        window(lines.timestamp, '10 seconds', '5 seconds'),
        # second key: a column ref against the freshly-projected schema;
        # pykrete uses a bare-string to stay future-proof here.
        'word',
    ).count().orderBy('word')


# ----------------------------------------------------------------------
# Original upstream script body (unchanged from apache/spark@d004e0d8).
# ----------------------------------------------------------------------


if __name__ == "__main__":
    if len(sys.argv) != 5 and len(sys.argv) != 4:
        msg = ("Usage: structured_network_wordcount_windowed.py <hostname> <port> "
               "<window duration in seconds> [<slide duration in seconds>]")
        print(msg, file=sys.stderr)
        sys.exit(-1)

    host = sys.argv[1]
    port = int(sys.argv[2])
    windowSize = int(sys.argv[3])
    slideSize = int(sys.argv[4]) if (len(sys.argv) == 5) else windowSize
    if slideSize > windowSize:
        print("<slide duration> must be less than or equal to <window duration>", file=sys.stderr)
    windowDuration = '{} seconds'.format(windowSize)
    slideDuration = '{} seconds'.format(slideSize)

    spark = SparkSession\
        .builder\
        .appName("StructuredNetworkWordCountWindowed")\
        .getOrCreate()

    lines = spark\
        .readStream\
        .format('socket')\
        .option('host', host)\
        .option('port', port)\
        .option('includeTimestamp', 'true')\
        .load()

    words = lines.select(
        explode(split(lines.value, ' ')).alias('word'),
        lines.timestamp
    )

    windowedCounts = words.groupBy(
        window(words.timestamp, windowDuration, slideDuration),
        words.word
    ).count().orderBy('window')

    query = windowedCounts\
        .writeStream\
        .outputMode('complete')\
        .format('console')\
        .option('truncate', 'false')\
        .start()

    query.awaitTermination()
