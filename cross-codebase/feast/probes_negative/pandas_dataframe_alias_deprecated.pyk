# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the same EntityRow shape as the sibling
# annotated/sdk/python/feast/pandas_entity_df.pyk. The annotated
# sibling uses the canonical `PandasFrame[X]` v1.3 form; this fixture
# uses the deprecated `DataFrame[X]` alias to assert that pykrete
# fires D0090 (deprecatedDataFrameAlias) per
# docs/design/pandas-support.md §6.
#
# Failure mode exercised: D0090 fires once per `DataFrame[X]`
# parameter annotation slot (v1.3 deprecation warning).
#
# Naming note: this file lives next to the pandas additions because
# v1.3 introduces D0090 alongside the PandasFrame[X] surface, but the
# diagnostic itself is dialect-agnostic — DataFrame[X] is now the
# generic alias regardless of pandas vs Spark routing, and the same
# .pyk would fire under a Spark-typed receiver too.

from pykrete import DataFrame


class EntityRowDep(Schema):
    driver_id: long
    event_timestamp: timestamp
    customer_id: string


# PROBE-EXPECTS: D0090 on "DataFrame[EntityRowDep]" id=feast-pandas-neg-dataframe-alias-deprecated -- DataFrame[X] alias on a parameter slot must fire D0090 per §6
def build_entity_df(combined: DataFrame[EntityRowDep]) -> None:
    _ = combined
