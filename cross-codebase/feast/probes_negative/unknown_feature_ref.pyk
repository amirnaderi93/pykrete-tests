from pyspark.sql import DataFrame
from pyspark.sql.functions import col


class FeatureRowNeg(Schema):
    entity_id: long
    value: double


def project_unknown_feature(df: DataFrame[FeatureRowNeg]) -> DataFrame:
# PROBE-EXPECTS: D0030 on "\"feature_score\"" id=feast-neg-unknown-feature -- feature_score is not in FeatureRowNeg
    return df.select(col("feature_score"))
