from pykrete import PandasFrame


class TidyDataStackNeg(Schema):
    unit_id: long
    measure_a: double
    measure_b: double
    measure_c: double


def stack_unknown_level(df: PandasFrame[TidyDataStackNeg]) -> None:
# PROBE-EXPECTS: D0030 on "\"measure_x\"" id=seaborn-pandas-neg-stack-unknown-level -- v1.10 PR-D2 negative: `level="measure_x"` is a typo; the literal is absent from TidyDataStackNeg so the pandas stack literal-form arm fires D0030 on the literal's range against the donor schema (the v1.10 arm validates each literal string `level=` independently per spec §4.1)
    _ = df.stack(level="measure_x")
