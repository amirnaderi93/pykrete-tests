# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the seaborn relational TidyData shape (sibling
# annotated/seaborn/relational.pyk); the annotated sibling uses the
# canonical `PandasFrame[X]` v1.3 form, this fixture uses the
# deprecated `DataFrame[X]` alias to assert pykrete fires D0090 per
# docs/design/pandas-support.md §6.
#
# Failure mode exercised: D0090 fires once per `DataFrame[X]`
# parameter annotation slot (v1.3 deprecation warning).

from pykrete import DataFrame


class TidyDataDep(Schema):
    x_raw: double
    y_raw: double
    hue_raw: string


# PROBE-EXPECTS: D0090 on "DataFrame[TidyDataDep]" id=seaborn-pandas-neg-dataframe-alias -- DataFrame[X] alias on a parameter slot must fire D0090 per §6
def axis_rename_alias(df: DataFrame[TidyDataDep]) -> None:
    _ = df
