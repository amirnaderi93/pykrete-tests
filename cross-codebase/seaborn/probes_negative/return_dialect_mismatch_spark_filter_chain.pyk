# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from seaborn's relational TidyData pattern (sibling
# annotated/seaborn/relational.pyk). Seaborn's plotting APIs are
# pandas-only; real upstream seaborn user code keeps the tidy frame
# in pandas. This fixture declares the return as
# PandasFrame[TidyData] but the body chains a SparkFrame-typed
# parameter through `.filter(...)` (a row-filter that preserves the
# column set), so the v1.13 PR-D1 dialect-on-return arm in
# operations/driver.rs fires D0080 with the dialect-mismatch clause:
# declared PandasFrame, body produces SparkFrame.
#
# Failure mode exercised: column NAMES + TYPES match (TidyData on
# both sides — `.filter(...)` preserves the schema), but the DIALECT
# differs through a CHAINED handoff — `sdf.filter(...)` rides the
# Spark dialect tag from the parameter down the chain. The v1.13
# arm's chain-walker (`inherited_chain_state`) propagates the Spark
# dialect to the return expression. The `.filter` choice (instead of
# `.select`) isolates the dialect arm from D0050 column-set mismatch
# noise — a `.select("x_raw")` would also fire D0050 because the
# projected schema is a proper subset of TidyData.
#
# Vacuity-falsifying: flipping the parameter annotation to
# PandasFrame[TidyData] clears the fire — both sides become
# PandasFrame.
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually pair a PandasFrame return with a
# SparkFrame parameter and forward a chained filter. This fixture
# mirrors the shape of work users do AROUND seaborn relational plots
# (annotate a pandas tidy-data return, accidentally take a Spark-typed
# input and filter before returning). The TidyData schema IS faithful
# to the donor.

from pykrete import PandasFrame, SparkFrame


class TidyData(Schema):
    x_raw: double
    y_raw: double
    hue_raw: string


def tidy_forward_spark_filter(sdf: SparkFrame[TidyData]) -> PandasFrame[TidyData]:
# PROBE-EXPECTS: D0080 on "sdf.filter(\"x_raw > 0\")" id=seaborn-pandas-neg-return-dialect-mismatch-spark-filter-chain -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared PandasFrame[TidyData] but body produces SparkFrame[TidyData] via sdf.filter(...) chained row-filter (inherited_chain_state propagates the Spark dialect tag from the parameter; .filter preserves the column set so no D0050 noise); v1.13 dialect comparison fires D0080 on the return expression range; vacuity-falsifying because flipping the parameter annotation to PandasFrame[TidyData] clears the fire
    return sdf.filter("x_raw > 0")
