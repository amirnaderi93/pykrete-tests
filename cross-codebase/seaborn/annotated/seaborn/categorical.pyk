#
# Annotated for pykrete from seaborn/categorical.py at mwaskom/seaborn,
# pinned-commit 9521ea1 (tag v0.13.2).
#
# Strategy: this is the one verified dispatched-shape exercise in
# seaborn's own source — the wide-orient axis swap at L79 uses a
# dict-literal kwarg, which IS what pykrete dispatches at
# expr.rs:938 (apply_pandas_rename → apply_rename_dict).
#
# Upstream evidence (paste-from-source, v0.13.2):
#   # seaborn/categorical.py @ v0.13.2, L75-90
#   # For wide data, orient determines assignment to x/y differently from the
#   # default VectorPlotter rules. If we do decide to make orient part of the
#   # _base variable assignment, we'll want to figure out how to express that.
#   if self.input_format == "wide" and orient in ["h", "y"]:
#       self.plot_data = self.plot_data.rename(columns={"x": "y", "y": "x"})
#       orig_variables = set(self.variables)
#       orig_x = self.variables.pop("x", None)
#       orig_y = self.variables.pop("y", None)
#       orig_x_type = self.var_types.pop("x", None)
#       orig_y_type = self.var_types.pop("y", None)
#       if "x" in orig_variables:
#           self.variables["y"] = orig_x
#           ...
#
# Schema dtypes (per docs/design/pandas-support.md §4):
#   - Categorical plot axis columns are numeric measurement values
#     (`x`, `y` are passed through to matplotlib ax.{bar,box,strip} which
#     coerces to numeric) → ColumnType::Double per pandas defaults.
#   - `marker_image` is a pandas `bytes`-object column carrying per-row
#     PNG bytes — the canonical pandas shape for image-marker scatter
#     overlays (matplotlib `OffsetImage`-based custom markers commonly
#     written alongside seaborn categorical plots); maps to
#     ColumnType::Binary per docs/design/pandas-support.md §4 "Other /
#     structured". Picked over timestamp because the strict-operator
#     checker (strict_operators.rs:31-67) only fires D0081 on Textual /
#     Collection families — Binary is Collection ("non-combining
#     atomic") so the synth wrap fires; Timestamp is Temporal and would
#     not fire.
#   - The wide-orient swap rebinds x/y but preserves dtype on the swap;
#     the post-swap fixture verifies post-rename col-ref resolution.
#
# Features covered:
#   - PandasFrame[X] annotation recognition (piece (a))
#   - df.rename(columns={...}) dispatch row with the verified
#     in-library shape from categorical.py:L79
#   - Post-rename col-ref resolution on swapped axis names
#   - PROBE-TYPE-IS dtype-retention on a binary atomic (Collection
#     family; dispatches to D0081 under the synth wrap)

from pykrete import PandasFrame


class PlotData(Schema):
    x: double
    y: double
    marker_image: binary


def wide_orient_axis_swap(plot_data: PandasFrame[PlotData]) -> None:
    """Mirrors categorical.py:L79 verbatim — wide-orient axis swap via
    dict-literal rename."""
    swapped = plot_data.rename(columns={"x": "y", "y": "x"})
# PROBE-RESOLVES: id=seaborn-categorical-wide-swap-y -- after the {"x":"y","y":"x"} swap the renamed view has both `x` and `y` keys (rename is two-way); both must resolve
    _ = swapped["y"]
# PROBE-RESOLVES: id=seaborn-categorical-wide-swap-x -- mirror of the above; post-swap `x` resolves
    _ = swapped["x"]


def marker_image_typed_probe(plot_data: PandasFrame[PlotData]) -> None:
    """TYPE-IS probe on a non-numeric atomic (binary). Adds substrate
    diversity beyond the string-only TYPE-IS markers in relational.pyk;
    closes the spec §1 line 64 floor (≥3 PROBE-TYPE-IS per donor)."""
# PROBE-TYPE-IS: binary on "marker_image" id=seaborn-categorical-marker-image-type -- marker_image is binary in PlotData; synth wraps in plot_data.select(col("marker_image") + lit(1)) under strict mode and fires D0081 (Binary is Collection-family per strict_operators.rs:58); flipping the dtype to double in the schema clears the fire — vacuity-falsifying
    _ = plot_data["marker_image"]
