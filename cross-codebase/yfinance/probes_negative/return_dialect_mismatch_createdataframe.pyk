# probes_negative/ fixture — deliberately broken, NOT donor-faithful.
# Derived from the yfinance OHLCRow shape (sibling
# annotated/yfinance/utils.pyk). Real upstream yfinance code keeps
# OHLC frames in pandas (yfinance is a pandas-native ticker-data
# library); this fixture declares the return as PandasFrame[OHLCRow]
# but the body hands off to Spark via
# `spark.createDataFrame(pdf, schema=...)`, so the v1.13 PR-D1
# dialect-on-return arm in operations/driver.rs fires D0080 with the
# dialect-mismatch clause: declared PandasFrame, body produces
# SparkFrame.
#
# Failure mode exercised: column NAMES + TYPES match (OHLCRow on
# both sides), but the DIALECT differs — declared PandasFrame, actual
# SparkFrame via the `spark.createDataFrame` handoff gate
# (operations/driver.rs `cross_dialect_handoff_gate`). Widens
# pandas-direct-dispatch donor coverage to yfinance.
#
# Vacuity-falsifying: removing the `spark.createDataFrame(...)` wrap
# (returning `pdf` directly) clears the fire — both sides become
# PandasFrame[OHLCRow].
#
# Synthesis disclosure: D0080 dialect-on-return cases are rare in real
# adopter code — devs don't usually annotate a pandas return and then
# convert to Spark inside the function. This fixture mirrors the
# shape of work users do AROUND yfinance ticker pulls (download OHLC
# pandas, accidentally promote to Spark before returning to a
# downstream pipeline). The OHLCRow schema IS faithful to the donor.

from pykrete import PandasFrame
from pyspark.sql import SparkSession


class OHLCRow(Schema):
    Open: double
    High: double
    Low: double
    Close: double
    AdjClose: double


def fetch_ohlc_then_promote_to_spark(
    pdf: PandasFrame[OHLCRow],
    spark: SparkSession,
) -> PandasFrame[OHLCRow]:
# PROBE-EXPECTS: D0080 on "spark.createDataFrame(pdf, schema=OHLCRow)" id=yfinance-pandas-neg-return-dialect-mismatch-createdataframe -- v1.13 PR-D1 D0080 returnTypeMismatch dialect-on-return arm: declared PandasFrame[OHLCRow] but body produces SparkFrame[OHLCRow] via spark.createDataFrame handoff (cross_dialect_handoff_gate in operations/driver.rs flips the dialect to Spark); v1.13 dialect comparison fires D0080 on the return expression range; vacuity-falsifying because returning pdf directly clears the fire
    return spark.createDataFrame(pdf, schema=OHLCRow)
